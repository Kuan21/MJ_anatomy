# Rebuilt from the pinned Three.js package before dev/build
/public/draco/draco_*

# Pinned Brain Project asset verified and vendored before dev/build
/public/models/brain.glb

# Pinned Z-Anatomy joint source
/public/models/joints.glb

/public/models/articular-surfaces.json

/public/models/neck-vessels.json

# Lossless, content-addressed delivery packages generated from the source atlas
/public/models/stream/
/public/models/atlas-stream.json*
/public/models/nerve-stream.json
/public/models/quiz-*.json

# Pinned facial-muscle source, verified and repackaged before dev/build
/public/models/facial/facial-stream.json.gz

# BodyParts3D 3.0 structures missing from the 4.0 export, verified and packaged before dev/build
/public/models/supplement/supplement-stream.json.gz

# Skin/fascia weights over the shared segment chain, computed from the atlas before dev/build
/public/models/skin-weights.json.gz

# Names of structures outside the atlas concepts, generated for search
/public/models/search-extras.json.gz
